rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated and is the owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // =========================================================
    // USERS COLLECTION
    // Users can only read/write their own profile
    // =========================================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Allow access to settings subcollection
      match /settings/{document=**} {
        allow read, write: if isOwner(userId);
      }
      
      // Allow access to localizacoes subcollection (Trip Planner)
      match /localizacoes/{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Allow access to fcmTokens (Notifications)
      match /fcmTokens/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // =========================================================
    // VEÍCULOS COLLECTION
    // Documents must have a 'userId' field matching the auth token
    // =========================================================
    match /veiculos/{veiculoId} {
      // Allow create if authenticated and the new document has the correct userId
      allow create: if request.auth != null && 
                      request.resource.data.userId == request.auth.uid;
      
      // Allow read/update/delete if the existing document belongs to the user
      allow read, update, delete: if request.auth != null && 
                                     resource.data.userId == request.auth.uid;

      // -------------------------------------------------------
      // SUBCOLLECTIONS (abastecimentos, documentos, reparacoes)
      // Inherit access from the parent vehicle
      // -------------------------------------------------------
      
      match /abastecimentos/{abastId} {
        // We check the PARENT vehicle's ownership using get()
        // Note: usage of get() counts as a read operation.
        // For optimization, we often store userId on subcollection docs too,
        // but checking parent is safer for strict hierarchy if userId isn't redundant.
        // However, your code saves userId on abastecimentos too.
        // So we can check resource.data.userId for existing, and request.resource.data for new.
        
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        // Allow read/write if the user owns the parent vehicle
        allow read, update, delete: if request.auth != null && 
          get(/databases/$(database)/documents/veiculos/$(veiculoId)).data.userId == request.auth.uid;
      }

      match /documentos/{docId} {
        allow read, write: if request.auth != null && 
          get(/databases/$(database)/documents/veiculos/$(veiculoId)).data.userId == request.auth.uid;
      }

      match /reparacoes/{repId} {
         // Your code for repairs currently might NOT be saving userId explicitly?
         // Let's check the code... 
         // Assuming consistent pattern or parent check:
         allow read, write: if request.auth != null && 
            get(/databases/$(database)/documents/veiculos/$(veiculoId)).data.userId == request.auth.uid;
      }

      match /manutencoesPlaneadas/{planId} {
         allow read, write: if request.auth != null && 
            get(/databases/$(database)/documents/veiculos/$(veiculoId)).data.userId == request.auth.uid;
      }

      // Allow access to analytics (Smart Vehicle)
      match /analytics/{docId} {
         allow read, write: if request.auth != null && 
            get(/databases/$(database)/documents/veiculos/$(veiculoId)).data.userId == request.auth.uid;
      }
      
      // Allow access to OBD Data (Torque/Import)
      match /leiturasObd/{readingId} {
         // Read/Write for client (needed for CSV/ZIP import from UI)
         allow read, write: if request.auth != null && 
            get(/databases/$(database)/documents/veiculos/$(veiculoId)).data.userId == request.auth.uid;
      }

      // Allow access to Trips (History)
      match /viagens/{tripId} {
         allow read, write: if request.auth != null && 
            get(/databases/$(database)/documents/veiculos/$(veiculoId)).data.userId == request.auth.uid;
      }

      // Allow access to Diagnostics (Mode $06)
      match /diagnosticos/{diagId} {
         allow read, write: if request.auth != null && 
            get(/databases/$(database)/documents/veiculos/$(veiculoId)).data.userId == request.auth.uid;
      }
    }

  }
}
